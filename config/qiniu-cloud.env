# 七牛云 Qiniu Cloud 配置
# 请将此文件内容复制到项目根目录的 .env 文件中

# 应用基础配置  
VITE_APP_TITLE=MilesXWalkerStudio
VITE_APP_VERSION=0.1.0
VITE_APP_DESCRIPTION=Vue3 + 七牛云存储博客系统
VITE_APP_ENV=development

# 七牛云配置 - 对象存储 Kodo
# ========================================
# 🔑 访问密钥 - 从七牛云控制台获取
# 访问: https://portal.qiniu.com/user/key
QINIU_ACCESS_KEY=your_access_key_here
QINIU_SECRET_KEY=your_secret_key_here

# 🪣 存储空间配置
QINIU_BUCKET=your_bucket_name_here
QINIU_REGION=cn-east-1
QINIU_ZONE=z0

# 🌐 访问域名配置
QINIU_DOMAIN=your_domain_here
# 示例: https://cdn.example.com 或测试域名

# 📁 文件上传配置
QINIU_PATH_PREFIX=uploads/
QINIU_MAX_FILE_SIZE=10485760
# 默认10MB = 10 * 1024 * 1024

# 🔐 安全配置
QINIU_PRIVATE_BUCKET=false
QINIU_EXPIRE_TIME=3600
# Token过期时间，单位秒，默认1小时

# 前端配置（VITE_前缀，可在前端使用）
VITE_QINIU_DOMAIN=your_domain_here
VITE_QINIU_BUCKET=your_bucket_name_here
VITE_QINIU_REGION=cn-east-1
VITE_QINIU_UPLOAD_URL=https://upload.qiniup.com

# 功能开关
VITE_ENABLE_QINIU=true
VITE_ENABLE_QINIU_DEBUG=true

# 七牛云 API 端点
QINIU_API_BASE_URL=https://rs.qbox.me
QINIU_UPLOAD_URL=https://upload.qiniup.com
QINIU_RS_HOST=rs.qbox.me
QINIU_RSF_HOST=rsf.qbox.me

# qshell 工具配置
QSHELL_PATH=/Users/neo/Cursor project/qshell 